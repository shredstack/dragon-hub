<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Universal Links: lets iOS open https://dragonhub.shredstack.net/* directly in the app. -->
  <!-- Requires apple-app-site-association at the matched domain. -->
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>applinks:dragonhub.shredstack.net</string>
    <string>webcredentials:dragonhub.shredstack.net</string>
  </array>

  <!-- APNs environment. "production" is the value every shipped build needs — -->
  <!-- Xcode does NOT switch this automatically, and the entitlement is baked -->
  <!-- into the signed app, so a "development" archive uploaded to TestFlight -->
  <!-- silently receives no pushes at all. scripts/preflight-ios.sh greps for -->
  <!-- that mistake and exits non-zero; run it before every archive. -->
  <!--
    Switching back to "development" is legitimate while debugging from Xcode
    against the APNs sandbox (with APNS_PRODUCTION unset on the server) — just
    switch it back, and let the preflight script catch you if you forget.
  -->
  <key>aps-environment</key>
  <string>production</string>

  <!-- Sign in with Apple. Required for the provider registered in src/lib/auth.ts;
       without it the native authorization request fails with an unhelpful error. -->
  <key>com.apple.developer.applesignin</key>
  <array>
    <string>Default</string>
  </array>
</dict>
</plist>
