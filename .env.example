# Neon Database
# For development: use a Neon branch (not production!)
# Create a dev branch: neonctl branches create --name dev
# Get the connection string: neonctl connection-string dev
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# NextAuth.js (Auth.js v5)
# Run `openssl rand -base64 32` to generate
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Resend (email magic links)
AUTH_RESEND_KEY=re_xxxxx
# Optional: custom from address (requires verified domain in Resend)
# EMAIL_FROM="DragonHub <dragonhub@shredstack.net>"

# Google sign-in (OPTIONAL — omit both and the button is hidden, magic links
# keep working). These are an OAuth 2.0 *Web application* client, which is NOT
# the same credential as the per-school service account used for Calendar and
# Drive sync.
#   Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID
#   Authorized redirect URIs must include, for each origin you run on:
#     http://localhost:3000/api/auth/callback/google
#     https://dragonhub.shredstack.net/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Blob storage
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxx

# NOTE: Google integrations (Calendar, Drive, Budget) are now configured
# per-school via the admin dashboard at /admin/integrations.
# Service account credentials and resource IDs are stored in the database.

# Encryption key for sensitive data (Google private keys)
# Generate with: openssl rand -hex 32
# IMPORTANT: Keep this safe! Losing it means encrypted data cannot be recovered.
ENCRYPTION_KEY=

# Anthropic (article generation)
ANTHROPIC_API_KEY=

# 32auctions
AUCTIONS_32_API_KEY=

# Cron job security
CRON_SECRET=

# Vercel Blob (profile picture uploads)
# Get this from your Vercel project settings > Storage > Blob
BLOB_READ_WRITE_TOKEN=

# ── Sign in with Apple (OPTIONAL) ───────────────────────────────────────────
# Required under App Store Guideline 4.8 once Google sign-in is offered.
# All four must be set or the provider is not registered and the button is
# hidden — see `isAppleAuthConfigured` in src/lib/auth-providers.ts.
#
# AUTH_APPLE_ID is the **Services ID** (e.g. net.shredstack.dragonhub.web), NOT
# the bundle ID. Using the bundle ID fails at Apple's authorize endpoint with
# `invalid_client` and no other clue.
#
# The "client secret" is a JWT this app signs at runtime from the .p8 key
# (src/lib/apple-client-secret.ts), so there is nothing to rotate — do not
# paste a pre-generated secret anywhere, they expire after 6 months.
#
# NB: Apple replies with a cross-site form POST, so the state/PKCE/nonce
# cookies are SameSite=None, which requires HTTPS. **Apple sign-in cannot be
# tested over plain-HTTP localhost** — use a tunnel or a preview deployment.
AUTH_APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── App Store / Play reviewer sign-in (OPTIONAL) ────────────────────────────
# Both stores reject an app whose content is behind a login they cannot get
# past. Both variables must be set or the Credentials provider is not
# registered at all, and /sign-in?demo=1 renders nothing.
#
# The address must match a seeded account: run `npm run db:seed:demo` after
# setting DEMO_LOGIN_EMAIL. The account must NOT be a super admin — the
# provider refuses to sign in one.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=

# ── Push notifications (OPTIONAL — missing creds make the platform a no-op) ──
# iOS, via APNs. APNS_PRODUCTION must be "true" for TestFlight and App Store
# builds, and the aps-environment entitlement must say "production" to match.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=net.shredstack.dragonhub
APNS_PRIVATE_KEY=
APNS_PRODUCTION=

# Android, via FCM. NOTE: these are only half of it — Android also needs
# android/app/google-services.json in the app itself, without which FCM is
# completely inert with no error. See mobile-shell/README.md.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
